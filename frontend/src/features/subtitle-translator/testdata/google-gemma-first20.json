    { "idx": 1, "timecode": "00:00:12,086 --> 00:00:12,166", "text": "はい。" },
    { "idx": 2, "timecode": "00:00:17,403 --> 00:00:17,504", "text": "え。" },
    { "idx": 3, "timecode": "00:00:44,677 --> 00:00:45,637", "text": "♪(ポッ音)" },
    { "idx": 4, "timecode": "00:01:07,441 --> 00:01:10,662", "text": "はい、もしもし白岩です。" },
    { "idx": 5, "timecode": "00:01:12,441 --> 00:01:13,882", "text": "ちょっと待ってください" },
    { "idx": 6, "timecode": "00:01:16,762 --> 00:01:21,361", "text": "一応まとめて送らせていただきました" },
    { "idx": 7, "timecode": "00:01:24,941 --> 00:01:26,141", "text": "そうですよね" },
    { "idx": 8, "timecode": "00:01:26,141 --> 00:01:28,962", "text": "時間がなくてすみません" },
    { "idx": 9, "timecode": "00:01:30,102 --> 00:01:31,201", "text": "説明します" },
    { "idx": 10, "timecode": "00:01:38,162 --> 00:01:41,941", "text": "僕と友は3年前に結婚しました" },
    { "idx": 11, "timecode": "00:01:44,861 --> 00:01:48,281", "text": "よく言われます アイドルみたいだねとか" },
    { "idx": 12, "timecode": "00:01:49,802 --> 00:01:52,701", "text": "なんでお前なんかがこんな美人の結婚できたんだって" },
    { "idx": 13, "timecode": "00:01:54,941 --> 00:01:59,081", "text": "幼馴染なんですよ 小学校の時に転校してきて" },
    { "idx": 14, "timecode": "00:02:00,341 --> 00:02:04,001", "text": "それから小中高等 ずっと一緒です" },
    { "idx": 15, "timecode": "00:02:07,569 --> 00:02:14,430", "text": "初恋でしたね。でも、妻の初恋 の相手は僕ではないと思います" },
    { "idx": 16, "timecode": "00:02:18,610 --> 00:02:19,969", "text": "サジハンゾーです" },
    { "idx": 17, "timecode": "00:02:20,569 --> 00:02:21,229", "text": "小中高等" },
    { "idx": 18, "timecode": "00:02:21,870 --> 00:02:22,710", "text": "一緒で" },
    { "idx": 19, "timecode": "00:02:22,710 --> 00:02:26,810", "text": "はい。 ハンズオも幼馴染み です" },
    { "idx": 20, "timecode": "00:02:28,789 --> 00:02:31,050", "text": "僕 は勉強が苦手 で" }
  ]
